{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges"
  ],
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "groupName": "Monday packages",
      "matchPackageNames": [
        "actions/checkout",
        "actions/create-github-app-token",
        "aquasecurity/trivy-action",
        "ludeeus/action-shellcheck",
        "Mattraks/delete-workflow-runs",
        "peter-evans/create-pull-request",
        "rhysd/actionlint",
        "terraform-docs/gh-actions"
      ],
      "minimumReleaseAge": "7 days",
      "reviewers": [
        "ulfiac"
      ],
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "automerge": true,
      "groupName": "container packages",
      "matchPackageNames": [
        "ghcr.io/ulfiac/terraform-fmt",
        "ghcr.io/ulfiac/terragrunt-hcl-fmt",
        "ghcr.io/ulfiac/tflint"
      ]
    },
    {
      "description": "actionlint 1.7.12 does not support ubuntu-26.04 runners; pin until it does (see ulfiac/commons#200)",
      "matchDepTypes": [
        "github-runner"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "24.04"
    }
  ],
  "prHourlyLimit": 5,
  "timezone": "America/New_York"
}
